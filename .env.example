# Valuonic configuration.
# Local development: copy this file to .env, it works without any changes.
# Production: change every value marked [PROD].

# --- Database (reachable only from inside Docker) ---
POSTGRES_USER=valuonic
# [PROD] Use a long random password: openssl rand -hex 24
POSTGRES_PASSWORD=valuonic
POSTGRES_DB=valuonic

# --- Sessions ---
# Signs the session tokens. [PROD] Generate your own: openssl rand -hex 32
SECRET_KEY=dev-only-secret-key-do-not-use-in-production-000000

# --- Frontend ---
# Used in email links. It also decides whether the session cookie requires HTTPS.
# [PROD] https://your-domain.com (no trailing slash)
FRONTEND_URL=http://localhost:3000

# --- Email (account verification, password reset) ---
# Leave empty to send nothing: the links are printed in the API logs (docker compose logs api).
# Sent over SSL. When empty, SMTP_HOST defaults to smtp.zoho.com and SMTP_PORT to 465.
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=
SMTP_PORT=

# --- Administration ---
# Comma-separated emails with access to the admin panel. Locally, the demo account created by seed_demo.
# [PROD] Use your own email: the API refuses to start with the demo account as admin on a real deployment.
ADMIN_EMAILS=demo@example.com

# --- Google sign-in (optional) ---
# OAuth Client ID from Google Cloud, used by both the API and the frontend. Empty = email sign-in only.
GOOGLE_CLIENT_ID=

# --- Market data for development ---
# Where seed_demo and sync_prices download price and dollar-rate history from.
MARKET_DATA_SOURCE_URL=https://valuonic.linepixer.com/api/public/market-data
